{
    "name": "roxom-playout-manager",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3450",
        "build": "next build",
        "start": "next start -p ${PORT:-3000}",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "unused": "knip",
        "smoke:http": "node --test e2e/*.test.mjs",
        "smoke:local": "bash scripts/local_readonly_smoke.sh",
        "smoke:prod": "bash scripts/prod_readonly_smoke.sh",
        "smoke:staging-write": "bash scripts/staging_write_smoke.sh",
        "security:service-role": "node scripts/check_service_role_auth.mjs",
        "security:audit-trail": "node scripts/check_audited_mutations.mjs",
        "security:zod-routes": "node scripts/check_zod_routes.mjs",
        "i18n:check": "node scripts/i18n-check.mjs",
        "prepare": "husky",
        "cf:build": "opennextjs-cloudflare build",
        "cf:dev": "opennextjs-cloudflare build && wrangler dev",
        "cf:deploy": "opennextjs-cloudflare build && wrangler deploy --keep-vars",
        "cf:preview": "opennextjs-cloudflare build && wrangler versions upload",
        "deploy": "opennextjs-cloudflare build && wrangler deploy --keep-vars",
        "deploy:dev": "opennextjs-cloudflare build && wrangler deploy --keep-vars --env dev",
        "deploy:prod": "opennextjs-cloudflare build && wrangler deploy --keep-vars --env prod",
        "upload": "opennextjs-cloudflare build && wrangler deploy --keep-vars",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}": [
            "prettier --write"
        ],
        "*.{ts,tsx}": [
            "eslint --fix"
        ],
        "messages/*.json": [
            "node scripts/i18n-check.mjs"
        ]
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "framer-motion": "^11.18.2",
        "hls.js": "^1.6.16",
        "lucide-react": "^0.468.0",
        "next": "^15.3.1",
        "next-intl": "^4.11.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@next/env": "^15.5.18",
        "@opennextjs/cloudflare": "^1",
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.15.3",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^3.2.4",
        "autoprefixer": "^10.4.21",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.25.1",
        "eslint-config-next": "^15.3.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "jsdom": "^25.0.1",
        "knip": "^6.14.2",
        "lint-staged": "^17.0.3",
        "postcss": "^8.5.3",
        "prettier": "^3.8.3",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.3",
        "vitest": "^3.1.2",
        "wrangler": "^4"
    }
}
