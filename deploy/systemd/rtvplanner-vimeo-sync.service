[Unit]
Description=RTV Planner Vimeo catalog sync
After=network-online.target rtvplanner.service
Wants=network-online.target

[Service]
Type=oneshot
User=diego
WorkingDirectory=/home/diego/Documents/RTVplanner
EnvironmentFile=/home/diego/Documents/RTVplanner/.env
ExecStart=/home/diego/Documents/RTVplanner/scripts/sync_vimeo.sh
